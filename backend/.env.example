PROJECT_NAME="PeoplePay360"
PROJECT_SLOGAN="WageWise Enterprise Payroll & HR"
VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"

# Database (PostgreSQL URL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/peoplepay360"

# JWT & Security
JWT_SECRET_KEY="peoplepay360_super_secret_jwt_key_for_hackathon_2026_change_in_prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# SMTP / Mailer (Dev logs to console if empty)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@peoplepay360.com"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
