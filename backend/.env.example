# Application Settings
PROJECT_NAME="FastAPI Production Starter"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# Security / JWT
SECRET_KEY="change_this_to_a_secure_32_character_random_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
# SQLite configuration (Default for quick local development)
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# PostgreSQL configuration (Uncomment to use PostgreSQL)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/app_db"
# For Docker Compose, set:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/app_db"

# CORS Settings (JSON string array)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
